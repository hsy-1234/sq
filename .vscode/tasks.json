{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "构建全部",
            "type": "shell",
            "command": "mingw32-make",
            "args": [
                "all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "清理构建产物",
            "type": "shell",
            "command": "mingw32-make",
            "args": [
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "运行基础库自检",
            "type": "shell",
            "command": "${workspaceFolder}/build/bin/smoke.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "构建全部",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "运行题目一",
            "type": "shell",
            "command": "${workspaceFolder}/build/bin/lab01.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "构建全部",
            "problemMatcher": []
        },
        {
            "label": "运行题目二",
            "type": "shell",
            "command": "${workspaceFolder}/build/bin/lab02.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "构建全部",
            "problemMatcher": []
        },
        {
            "label": "运行题目三",
            "type": "shell",
            "command": "${workspaceFolder}/build/bin/lab03.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "构建全部",
            "problemMatcher": []
        },
        {
            "label": "运行题目四",
            "type": "shell",
            "command": "${workspaceFolder}/build/bin/lab04.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "构建全部",
            "problemMatcher": []
        },
        {
            "label": "运行趣味题（武汉地铁）",
            "type": "shell",
            "command": "${workspaceFolder}/build/bin/metro.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "构建全部",
            "problemMatcher": []
        },
        {
            "label": "运行地铁模块测试",
            "type": "shell",
            "command": "mingw32-make",
            "args": [
                "run-metro-test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe 生成活动文件",
            "command": "D:/MinGW64/x86_64-8.1.0-release-posix-sjlj-rt_v6-rev0/mingw64/bin/gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "D:/MinGW64/x86_64-8.1.0-release-posix-sjlj-rt_v6-rev0/mingw64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}